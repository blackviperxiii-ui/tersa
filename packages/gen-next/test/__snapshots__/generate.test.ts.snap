exports[`generate(dashboard example) > README.md matches snapshot 1`] = `
"# Acme Ops

Generated by [tersa](https://github.com/blackviperxiii-ui/tersa). Next.js App Router, Tailwind v4, shadcn-style components, \`aurora\` theme.

\`\`\`sh
pnpm install
pnpm dev
\`\`\`

- Pages: \`/dashboard\`, \`/settings\`
- Mock data lives in \`lib/data.ts\`; action stubs in \`lib/api.ts\`.
- Colors come from CSS variables in \`app/globals.css\`. Use the token utilities (\`bg-primary\`, \`text-muted-foreground\`) instead of raw values.
"
`;

