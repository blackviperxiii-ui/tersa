exports[`generate(dashboard example) > lib/api.ts matches snapshot 1`] = `
"// Action handlers referenced by the spec. Each one is a stub: wire them to real endpoints.
type ApiFn = (...args: never[]) => Promise<unknown>;

const delay = (ms = 400) => new Promise((resolve) => setTimeout(resolve, ms));

export const api: Record<string, ((...args: any[]) => Promise<unknown>) | undefined> = {
  async refund(id: unknown) {
    await delay();
    console.info("api.refund", { id });
  },
  async saveUser(values: Record<string, unknown>) {
    await delay();
    console.info("api.saveUser", values);
  },
};

export type { ApiFn };
"
`;

