{
  "name": "@tersa/themes",
  "version": "0.1.0",
  "description": "Tersa design-token presets (W3C DTCG), built with Style Dictionary into CSS variables and a Tailwind v4 theme.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aurora.css": "./css/aurora.css"
  },
  "files": [
    "dist",
    "css",
    "tokens"
  ],
  "scripts": {
    "build:tokens": "node scripts/build.mjs",
    "build": "node scripts/build.mjs && tsup src/index.ts --format esm --dts --clean"
  },
  "devDependencies": {
    "style-dictionary": "^5.7.0",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3"
  }
}
